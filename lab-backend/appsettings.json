{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Jwt": {
    "Key": "",
    "Issuer": "LabManagementAPI",
    "Audience": "LabManagementApp",
    "AccessTokenMinutes": 30
  },
  "App": {
    "FrontendBaseUrl": "http://localhost:5173"
  },
  "Email": {
    "Host": "",
    "Port": 587,
    "UseStartTls": true,
    "Username": "",
    "Password": "",
    "FromEmail": "",
    "FromName": "Lab Management"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173"
    ]
  },
  "ForwardedHeaders": {
    "TrustAll": false,
    "KnownProxies": []
  },
  "Security": {
    "UseHttpsRedirection": true,
    "RequireEncryptedDataProtectionKeys": false,
    "LoginRateLimitPermit": 5,
    "SensitiveRateLimitPermit": 30
  },
  "Database": {
    "ApplyMigrations": true
  },
  "Automation": {
    "Enabled": true,
    "PollMinutes": 5,
    "ReturnReminderDaysBefore": 3,
    "OverduePenaltyAmountPerDay": 10000,
    "SendEmailReminders": false,
    "EmailMaxAttempts": 3,
    "EmailRetryMinutes": 60
  },
  "Borrow": {
    "ApprovedHoldHours": 24
  },
  "Seed": {
    "Enabled": false,
    "DefaultPassword": ""
  },
  "Uploads": {
    "MaxDecisionFileBytes": 10485760,
    "MaxEvidenceFileBytes": 10485760
  },
  "Storage": {
    "Provider": "Local",
    "S3": {
      "ServiceUrl": "",
      "BucketName": "",
      "Region": "us-east-1",
      "AccessKey": "",
      "SecretKey": "",
      "ForcePathStyle": true,
      "KeyPrefix": "labmanagement"
    }
  }
}
