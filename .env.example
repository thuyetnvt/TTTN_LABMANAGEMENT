MYSQL_ROOT_PASSWORD=replace_with_strong_root_password
MYSQL_DATABASE=lab_management
MYSQL_USER=lab_app
MYSQL_PASSWORD=replace_with_strong_app_password

JWT_KEY=replace_with_random_secret_at_least_32_characters
JWT_ACCESS_TOKEN_MINUTES=30

APP_PORT=8080
APP_ORIGIN=http://localhost:8080

SEED_ENABLED=false
SEED_DEFAULT_PASSWORD=ChangeMe123!

SMTP_HOST=
SMTP_PORT=587
SMTP_USE_STARTTLS=true
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Lab Management

# Số giờ giữ chỗ sau khi quản lý duyệt nhưng chưa lập biên bản bàn giao
BORROW_APPROVED_HOLD_HOURS=24

# Lưu file: Local (mặc định) hoặc S3 cho AWS S3/MinIO/SeaweedFS tương thích S3
STORAGE_PROVIDER=Local
STORAGE_S3_SERVICE_URL=
STORAGE_S3_BUCKET_NAME=
STORAGE_S3_REGION=us-east-1
STORAGE_S3_ACCESS_KEY=
STORAGE_S3_SECRET_KEY=
STORAGE_S3_FORCE_PATH_STYLE=true
STORAGE_S3_KEY_PREFIX=labmanagement
