# Domain chỉ ghi hostname, không kèm https://
APP_DOMAIN=lab.example.edu.vn

MYSQL_ROOT_PASSWORD=replace_with_random_root_password
MYSQL_DATABASE=lab_management
MYSQL_USER=lab_app
MYSQL_PASSWORD=replace_with_random_app_password

JWT_KEY=replace_with_random_secret_at_least_32_characters
JWT_ACCESS_TOKEN_MINUTES=30
SEED_DEFAULT_PASSWORD=replace_with_random_unused_seed_password
APPLY_MIGRATIONS=true

# Đường dẫn tuyệt đối trên VPS tới PFX dùng riêng để mã hóa Data Protection keys.
DATA_PROTECTION_PFX_PATH=/opt/labmanagement/secrets/data-protection.pfx
DATA_PROTECTION_CERTIFICATE_PASSWORD=replace_with_random_certificate_password

SMTP_HOST=
SMTP_PORT=587
SMTP_USE_STARTTLS=true
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Lab Management

# Tác vụ nền: tự tạo phiếu bảo trì và nhắc trả trong ứng dụng.
AUTOMATION_ENABLED=true
AUTOMATION_POLL_MINUTES=5
RETURN_REMINDER_DAYS_BEFORE=3
# Chỉ bật true sau khi SMTP đã được cấu hình và kiểm thử.
AUTOMATION_SEND_EMAIL_REMINDERS=false
AUTOMATION_EMAIL_MAX_ATTEMPTS=3
AUTOMATION_EMAIL_RETRY_MINUTES=60

STORAGE_PROVIDER=Local
STORAGE_S3_SERVICE_URL=
STORAGE_S3_BUCKET_NAME=
STORAGE_S3_REGION=us-east-1
STORAGE_S3_ACCESS_KEY=
STORAGE_S3_SECRET_KEY=
STORAGE_S3_FORCE_PATH_STYLE=true
STORAGE_S3_KEY_PREFIX=labmanagement
